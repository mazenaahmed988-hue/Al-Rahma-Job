# ── Supabase (الخلفية) ──────────────────────────────────────────────
# هتجيب القيم دي من: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Edge Function (employee-lookup) secrets ────────────────────────
# دي بتتظبط على السحابة بمتغيرات الدالة نفسها (supabase secrets set):
#   SUPABASE_URL  |  SUPABASE_SERVICE_ROLE_KEY

# ── الموقع / النشر على Vercel ───────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
